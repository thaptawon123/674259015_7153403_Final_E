# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration (Option 1: Discrete Parameters)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learning_resources_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_DIALECT=postgres
DB_SSL=false

# Database Configuration (Option 2: Connection String for Render / Cloud Database)
# DATABASE_URL=postgres://username:password@ep-host.region.aws.neon.tech/learning_resources_db?sslmode=require

# CORS Allowed Origins (Comma separated or * for all)
CORS_ORIGIN=*
